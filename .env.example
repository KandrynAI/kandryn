DATABASE_URL=postgresql://user:password@localhost:5432/devcopilot

AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PAT=your-personal-access-token

JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token

ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

GITHUB_TOKEN=your-github-token
AZURE_REPOS_TOKEN=your-azure-repos-token

GIT_PROVIDER=github

# --- Jira app (Forge), phase 1 (0043) ---
# The Forge app id from `forge register`, in the form
# ari:cloud:ecosystem::app/<uuid>. forgeAuth refuses every request (503) when
# this is unset, because without it the token audience cannot be checked.
FORGE_APP_ID=
# Origin used in the panel's "Open in Kandryn" links and the link page URL.
APP_BASE_URL=https://app.kandryn.com
# Accept DEVELOPMENT/STAGING Forge tokens while NODE_ENV=production. Default
# false: a developer install is a real signed token, and this is the only
# thing standing between one and production data.
ALLOW_FORGE_DEV_ENV=false
# Kill switch. "false" makes every /api/ext/jira route answer 503 before any
# token or database work, so the feature can be turned off without a deploy.
JIRA_EXT_ENABLED=true
