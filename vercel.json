{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "artifacts/api-server/api/index.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 300 }
    },
    {
      "src": "artifacts/dev-copilot/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/artifacts/api-server/api/index.js" },
    { "src": "/(.*)", "dest": "/artifacts/dev-copilot/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/artifacts/dev-copilot/index.html" }
  ],
  "crons": [
    { "path": "/api/internal/dispatch-runs", "schedule": "*/5 * * * *" },
    { "path": "/api/internal/audit-cleanup", "schedule": "0 3 * * *" }
  ]
}
